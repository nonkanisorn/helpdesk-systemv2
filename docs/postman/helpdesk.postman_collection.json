      "name": "ยืนยันตัวตน / สาธารณะ",
      "description": "Public endpoints registered before JWT middleware. No Authorization header required.",
      "item": [
        {
          "name": "เข้าสู่ระบบ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Authenticate a user. Body uses domain.UserRequest: email, password. Response shape from handler: { user, token }. Test script saves response.token to Postman environment variable token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.environment.set(\"token\", json.token);",
                  "  pm.collectionVariables.set(\"token\", json.token);",
                  "}",
                  "if (json.user && json.user.id) {",
                  "  pm.collectionVariables.set(\"userId\", json.user.id);",
                  "}",
                  "pm.test(\"login returns token\", function () {",
                  "  pm.expect(json.token).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "เข้าสู่ระบบ (เส้นทางสำรอง /logina)",
